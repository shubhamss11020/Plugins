{
  "name": "raj-plugins",
  "displayName": "Raj's Suite",
  "version": "1.0.0",
  "description": "Raj's multi-connector MCP suite: Threads-wiki, Threads-OV, CEO, Ask Cruz, and Team EOXS.",
  "author": {
    "name": "Raj"
  },
  "mcpServers": {
    "threads-wiki": {
      "command": "node",
      "args": [
        "scripts/bridge.js",
        "--name",
        "threads-wiki"
      ]
    },
    "threads-ov": {
      "command": "node",
      "args": [
        "scripts/bridge.js",
        "--name",
        "threads-ov"
      ]
    },
    "ceo": {
      "command": "node",
      "args": [
        "scripts/bridge.js",
        "--name",
        "ceo"
      ]
    },
    "ask-cruz": {
      "command": "node",
      "args": [
        "scripts/bridge.js",
        "--name",
        "ask-cruz"
      ]
    },
    "team-eoxs": {
      "command": "node",
      "args": [
        "scripts/bridge.js",
        "--name",
        "team-eoxs"
      ]
    }
  }
}
